{
  "schemaVersion": 1,
  "id": "smokeapi",
  "name": "smokeapi",
  "displayName": "SmokeAPI",
  "description": "DLC unlocker for Steamworks games",
  "summary": "Legit DLC ownership emulation",
  "version": "4.1.3",
  "author": "acidicoala",
  "repository": "https://github.com/acidicoala/SmokeAPI",
  "license": "Unlicense",
  "categories": ["steam", "dlc"],
  "tags": ["smokeapi", "dlc", "unlocker"],
  "managedFiles": [
    {
      "path": "smoke_api32.dll",
      "required": false,
      "replaceStrategy": "always",
      "backupStrategy": "rename",
      "validationStrategy": "exists",
      "isExecutable": true
    },
    {
      "path": "smoke_api64.dll",
      "required": false,
      "replaceStrategy": "always",
      "backupStrategy": "rename",
      "validationStrategy": "exists",
      "isExecutable": true
    }
  ],
  "metadata": {
    "type": "tool",
    "surfaces": ["tools"],
    "toolConfig": {
      "target": "game-folder",
      "mode": "proxy",
      "files": [
        { "source": "smoke_api32.dll", "target": "steam_api.dll", "backupSuffix": "_o" },
        { "source": "smoke_api64.dll", "target": "steam_api64.dll", "backupSuffix": "_o" }
      ],
      "configFiles": [
        { "source": "SmokeAPI.config.json", "target": "SmokeAPI.config.json" }
      ],
      "backup": true
    }
  },
  "permissions": [
    { "id": "filesystem.write", "reason": "Copy files to game folder" },
    { "id": "filesystem.delete", "reason": "Remove files on revert" }
  ],
  "releaseProvider": {
    "provider": "github",
    "config": {
      "owner": "acidicoala",
      "repo": "SmokeAPI",
      "assetPattern": "*.zip",
      "tagPattern": "v*"
    }
  }
}
